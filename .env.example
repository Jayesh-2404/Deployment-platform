DEPLOY_PLATFORM_ADDR=:8080
DEPLOY_PLATFORM_DATA=.data/state.json

# V2: set to use PostgreSQL instead of JSON (e.g. via `docker compose up -d`).
# Example: postgres://deploy:deploy@localhost:5432/deploy_platform?sslmode=disable
DEPLOY_PLATFORM_DATABASE_URL=

# Minimum security: bearer token required for every /api/* request (except
# /api/health). The dashboard prompts for it once and stores it in the
# browser. Leave empty only for local development.
DEPLOY_PLATFORM_API_TOKEN=

# V3: "simulation" (default, no Docker needed) or "docker" for real deploys.
DEPLOY_PLATFORM_EXECUTOR=simulation
DEPLOY_PLATFORM_DOCKER_NETWORK=deploy-platform
DEPLOY_PLATFORM_CONTAINER_PORT=3000
DEPLOY_PLATFORM_HEALTH_TIMEOUT_SECONDS=60
DEPLOY_PLATFORM_MEMORY_LIMIT_MB=512
DEPLOY_PLATFORM_CPU_PERCENT=100

# V4: base domain for project live URLs (my-app.example.com). Empty disables
# proxy routing. Dashboard host defaults to deploy.<base-domain>.
DEPLOY_PLATFORM_BASE_DOMAIN=
DEPLOY_PLATFORM_DASHBOARD_HOST=
DEPLOY_PLATFORM_ACME_EMAIL=
DEPLOY_PLATFORM_CADDYFILE=/etc/caddy/Caddyfile
DEPLOY_PLATFORM_CADDY_BINARY=

# V6: shared secret for the GitHub webhook HMAC. Empty disables the endpoint.
DEPLOY_PLATFORM_WEBHOOK_SECRET=

# Worker poll interval in seconds.
DEPLOY_PLATFORM_POLL_INTERVAL_SECONDS=1
